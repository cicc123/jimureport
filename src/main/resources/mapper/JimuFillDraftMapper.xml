<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.jimureport.enhancement.mapper.JimuFillDraftMapper">

    <!-- 根据表单ID和用户ID查询草稿 -->
    <select id="selectByFormAndUser" resultType="com.jimureport.enhancement.entity.JimuFillDraft">
        SELECT *
        FROM jimu_fill_draft
        WHERE form_id = #{formId}
        AND user_id = #{userId}
        LIMIT 1
    </select>

</mapper>
