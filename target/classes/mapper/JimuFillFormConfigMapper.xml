<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.jimureport.enhancement.mapper.JimuFillFormConfigMapper">

    <!-- 根据报表ID查询表单配置 -->
    <select id="selectByReportId" resultType="com.jimureport.enhancement.entity.JimuFillFormConfig">
        SELECT *
        FROM jimu_fill_form_config
        WHERE report_id = #{reportId}
        AND status = '0'
        LIMIT 1
    </select>

</mapper>
